{
  "name": "@mimir-labs/cli",
  "version": "0.6.0",
  "description": "Mimir CLI, the reference implementation for the APS Protocol",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "bin": {
    "mimir": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "mimir": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeaBassLab/mimir.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/SeaBassLab/mimir#readme",
  "bugs": {
    "url": "https://github.com/SeaBassLab/mimir/issues"
  },
  "dependencies": {
    "@mimir-labs/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mimir",
    "aps",
    "protocol",
    "cli",
    "ai",
    "software-knowledge"
  ]
}
